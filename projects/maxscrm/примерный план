### 4.4 WebSocket для realtime-уведомлений

**Серверная часть (NestJS Gateway):**

```typescript
// notification.gateway.ts
@WebSocketGateway({
  cors: { origin: 'https://your-frontend.com' },
})
export class NotificationGateway implements OnGatewayConnection {
  @WebSocketServer()
  server: Server;

  // При подключении клиента
  handleConnection(client: WebSocket, req: Request) {
    const userId = this.extractUserIdFromToken(req);
    client.join(`user:${userId}`);
  }

  // Отправка уведомления
  sendNotification(userId: string, event: string, data: any) {
    this.server.to(`user:${userId}`).emit(event, data);
  }

  // Пример: новый заказ
  notifyNewOrder(shopOwnerId: string, orderId: string) {
    this.sendNotification(shopOwnerId, 'new_order', {
      order_id: orderId,
      timestamp: new Date().toISOString(),
    });
  }

  // Пример: изменился статус заказа
  notifyOrderStatusChanged(
    userId: string,
    orderId: string,
    newStatus: string,
  ) {
    this.sendNotification(userId, 'order_status_changed', {
      order_id: orderId,
      status: newStatus,
      timestamp: new Date().toISOString(),
    });
  }
}
```

**Клиентская часть (React):**

```typescript
// hooks/useNotifications.ts
export function useNotifications() {
  const [socket, setSocket] = useState<WebSocket | null>(null);

  useEffect(() => {
    const ws = new WebSocket('wss://your-api.com/ws/notifications');

    ws.onopen = () => {
      console.log('Connected to notifications');
    };

    ws.onmessage = (event) => {
      const { event: type, data } = JSON.parse(event.data);
      
      // Обработка событий
      switch (type) {
        case 'new_order':
          // Показать push-уведомление, обновить дашборд
          showNotification('Новый заказ!', `Заказ ${data.order_id}`);
          refetchDashboard();
          break;
        case 'order_status_changed':
          showNotification('Статус заказа изменён', `Заказ ${data.order_id}: ${data.status}`);
          refetchOrders();
          break;
        case 'low_stock':
          showNotification('Низкий остаток', `Товар ${data.product_name} < 5 шт`);
          break;
      }
    };

    setSocket(ws);

    return () => {
      ws.close();
    };
  }, []);

  return { socket };
}
```

**События (events):**
- `new_order` — новый заказ (для продавца)
- `order_status_changed` — изменился статус заказа (для клиента и продавца)
- `payment_received` — оплата получена (для продавца)
- `low_stock` — остаток товара < минимального (для продавца)
- `review_received` — новый отзыв (если есть плагин)

